# =========================================================
# Google Gemini API Credentials
# =========================================================
GEMINI_API_KEY=your_google_gemini_api_key_here

# =========================================================
# PostgreSQL Database Configuration
# =========================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metricmind
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

